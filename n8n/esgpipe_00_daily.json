    {
      "parameters": {
        "jsCode": "// 데일리 요약 — 하위 둘의 결과를 이어 붙인다.\n// 각 하위가 \"완료 한 건\"을 반환하므로 여기서 순서대로 읽으면 된다.\n// 실패를 조용히 버리지 않는다 — ok=false 인 단계가 있으면 전체가 실패다.\nconst stages = [];\nfor (const [label, node] of [['collect', '① 수집'], ['classify', '② 분류']]) {\n  try {\n    const j = $(node).first().json;\n    stages.push({ stage: label, ...j });\n  } catch (e) {\n    stages.push({ stage: label, ok: false, error: '결과를 못 읽었다: ' + String(e).slice(0, 120) });\n  }\n}\nreturn [{ json: {\n  ok: stages.every(s => s.ok === true),\n  stages,\n  finished_at: new Date().toISOString().replace(/\\.\\d{3}Z$/, 'Z'),\n}}];"
      },
